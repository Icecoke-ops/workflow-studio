{
  "_comment": "文件归属表。最长前缀优先匹配。改这里之前先找 Chief。",

  "rules": [
    { "owner": "chief",   "paths": ["docs/", "engine/api.py", "engine/stdtypes.py", "studio/contract.py", "tools/who_owns.py", "tests/smoke.py"] },
    { "owner": "engine",  "paths": ["engine/", "plugins/", "tools/", "workflows/"] },
    { "owner": "studio",  "paths": ["studio/", "tests/studio_api.py"] },
    { "owner": "vue",     "paths": ["frontend/", "tools/build_web.py"] },
    { "owner": "tester",  "paths": ["tests/"] }
  ],

  "read_only": ["reviewer", "occam"],

  "roles": {
    "chief":    "定契约、编排、验收；只拥有契约文件和归属表",
    "engine":   "引擎实现、示例插件、工具、示例工作流",
    "studio":   "Web API 后端（studio/）",
    "vue":      "可视化前端（frontend/）与前端构建脚本",
    "tester":   "测试套件（tests/test_*.py）",
    "reviewer": "只读审查（正确性）",
    "occam":    "只读审查（奥卡姆剃刀 / 过度设计）"
  }
}
